from collections.abc import Iterable
from typing import final, overload

__all__ = ["Point", "Polygon"]

@final
class Point:
    def __new__(cls, x: float, y: float) -> Point: ...
    @property
    def x(self) -> float: ...
    @x.setter
    def x(self, value: float) -> None: ...
    @property
    def y(self) -> float: ...
    @y.setter
    def y(self, value: float) -> None: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __getitem__(self, index: int, /) -> float: ...

PointInput = Point | tuple[float, float]

@final
class Polygon:
    def __new__(cls, points: Iterable[PointInput]) -> Polygon: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __len__(self) -> int: ...
    @overload
    def __getitem__(self, index: int, /) -> Point: ...
    @overload
    def __getitem__(self, index: slice, /) -> Polygon: ...
    def centroid(self) -> Point | None: ...
