set shell := ["bash", "-c"]

# List the default tasks
[private]
default:
    @just --list

# Builds Python bindings
build:
    @command -v maturin > /dev/null || { echo "maturin not found. From the repo root, in your virtualenv: pip install -e 'bindings/python[dev]'" >&2; exit 1; }
    @echo "Cleaning up stale C-extensions..."
    rm -f bernard_ledit/_bernard_ledit*.so
    maturin develop --extras test,lint

# Test Python bindings
test:
    #!/usr/bin/env bash
    if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN=python3
    else
    PYTHON_BIN=python
    fi
    if "$PYTHON_BIN" -m pytest --help 2>/dev/null | grep -q -- "-n "; then
    "$PYTHON_BIN" -m pytest -vvv -n auto
    else
    echo "pytest-xdist not installed for $PYTHON_BIN, running tests without parallel workers."
    "$PYTHON_BIN" -m pytest -vvv
    fi

# Lints with ruff, then reformats files in place; CI runs lint-check instead
lint:
    ruff check .
    ruff format

# Checks lint, formatting and types without changing any file: what CI runs
lint-check:
    ruff check .
    ruff format --check .
    mypy .

# Fix linting/formatting issues
format:
    ruff format .
    ruff check --fix .

# Clean up build artifacts
clean:
    rm -rf target/
    rm -rf *.egg-info/
    find . -type d -name "__pycache__" -exec rm -rf {} +
    rm -rf ./**/*.abi3.so

# Checks that the stubs match the built extension
stubs-check:
    python -m mypy.stubtest bernard_ledit --allowlist stubtest-allowlist.txt {{ if os() == "linux" { "--allowlist stubtest-allowlist-linux.txt" } else { "" } }}
