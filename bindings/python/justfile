set shell := ["bash", "-c"]

static_feature := if os() == "macos" {
    "static-pdfium-libcxx"
} else if os() == "windows" {
    "static-pdfium-msvc"
} else {
    "static-pdfium"
}
static_library := if os() == "windows" { "pdfium.lib" } else { "libpdfium.a" }

# List the default tasks
[private]
default:
    @just --list

# Check that the platform's static PDFium archive is available.
[private]
require-static-pdfium:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -z "${PDFIUM_STATIC_LIB_PATH:-}" ]; then
        echo "Set PDFIUM_STATIC_LIB_PATH to a directory containing {{static_library}}." >&2
        echo "See the Python binding installation instructions for downloading PDFium." >&2
        exit 1
    fi
    if [ ! -f "$PDFIUM_STATIC_LIB_PATH/{{static_library}}" ]; then
        echo "PDFium static archive not found: $PDFIUM_STATIC_LIB_PATH/{{static_library}}" >&2
        exit 1
    fi

# Builds Python bindings
build: require-static-pdfium
    @command -v maturin > /dev/null || { echo "maturin not found. Install it with: pip install 'maturin>=1.0,<2.0'" >&2; exit 1; }
    @echo "Cleaning up stale C-extensions..."
    rm -f bernard_ledit/_bernard_ledit*.so
    maturin develop --features {{static_feature}} --extras test,lint

# Builds a release wheel with PDFium statically linked.
wheel: require-static-pdfium
    maturin build --release --features {{static_feature}}

# Test Python bindings
test: build
    #!/usr/bin/env bash
    set -euo pipefail
    python -m pytest -vvv -n auto


# Lints with ruff, then reformats files in place; CI runs lint-check instead
lint:
    ruff check .
    ruff format

# Checks lint, formatting and types without changing any file: what CI runs
lint-check:
    ruff check .
    ruff format --check .
    mypy .

# Fix linting/formatting issues
format:
    ruff format .
    ruff check --fix .

# Clean up build artifacts
clean:
    rm -rf target/
    rm -rf *.egg-info/
    find . -type d -name "__pycache__" -exec rm -rf {} +
    rm -rf ./**/*.abi3.so

# Checks that the stubs match the built extension
stubs-check:
    python -m mypy.stubtest bernard_ledit --allowlist stubtest-allowlist.txt
