set shell := ["bash", "-c"]

[private]
default:
    @just --list

build:
    @echo "Cleaning up stale C-extensions..."
    rm -f bernard_ledit/_bernard_ledit*.so
    maturin develop --extras test,lint

wheel:
    maturin build --release

clean:
    rm -rf target/
    rm -rf *.egg-info/
    find . -type d -name "__pycache__" -exec rm -rf {} +
    rm -rf ./**/*.abi3.so

format:
    ruff format .
    ruff check --fix .

format-check:
    ruff format --check .
    ruff check .
    mypy .

stubs-check:
    python -m mypy.stubtest bernard_ledit --allowlist stubtest-allowlist.txt

test: build
    #!/usr/bin/env bash
    set -euo pipefail
    python -m pytest -vvv -n auto
