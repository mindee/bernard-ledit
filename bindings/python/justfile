set shell := ["bash", "-c"]

# List the default tasks
[private]
default:
    @just --list

# Builds Python bindings
build:
    maturin develop --extras test,lint

# Test Python bindings
test:
    #!/usr/bin/env bash
    mkdir -p ../../core/.pdfium_cache
    PDFIUM_FILE=$(find ../../core/.pdfium_cache -name "libpdfium.*" -o -name "pdfium.dll" | head -n 1)
    if [ -z "$PDFIUM_FILE" ]; then
    echo "⚠️ PDFium binary not found. Attempting to build core..."
    just core build
    PDFIUM_FILE=$(find ../../core/.pdfium_cache -name "libpdfium.*" -o -name "pdfium.dll" | head -n 1)
    fi
    if [ -z "$PDFIUM_FILE" ]; then
    echo "⚠️ PDFium binary not found. Attempting to build core..."
    just -f ../../justfile core build
    PDFIUM_FILE=$(find ../../core/.pdfium_cache -name "libpdfium.*" -o -name "pdfium.dll" | head -n 1)
    fi
    PDFIUM_LIB_PATH=$(realpath $(dirname "$PDFIUM_FILE"))
    echo "✅ Using PDFium from: $PDFIUM_LIB_PATH"
    export LD_LIBRARY_PATH="$PDFIUM_LIB_PATH:$LD_LIBRARY_PATH"
    export DYLD_LIBRARY_PATH="$PDFIUM_LIB_PATH:$DYLD_LIBRARY_PATH"
    export PATH="$PDFIUM_LIB_PATH:$PATH"
    if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN=python3
    else
    PYTHON_BIN=python
    fi
    if "$PYTHON_BIN" -m pytest --help 2>/dev/null | grep -q -- "-n "; then
    "$PYTHON_BIN" -m pytest -vvv -n auto
    else
    echo "⚠️ pytest-xdist not installed for $PYTHON_BIN, running tests without parallel workers."
    "$PYTHON_BIN" -m pytest -vvv
    fi

# Format and lint code using ruff
lint:
    ruff check .
    ruff format

# Format and lint code using ruff
lint-check:
    ruff check .
    ruff format --check .
    mypy .

# Fix linting/formatting issues
format:
    ruff format .
    ruff check --fix .

# Clean up build artifacts
clean:
    rm -rf target/
    rm -rf *.egg-info/
    find . -type d -name "__pycache__" -exec rm -rf {} +
    rm -rf ./**/*.abi3.so
