set shell := ["bash", "-c"]

[private]
default:
    @just --list

build:
    @echo "Cleaning up stale C-extensions..."
    rm -f bernard_ledit/_bernard_ledit*.so
    maturin develop --extras test,lint

wheel:
    maturin build --release

clean:
    #!/usr/bin/env bash
    set -euo pipefail
    cargo clean -p bernard-ledit-python
    target_dir="$(cargo metadata --no-deps --format-version 1 | yq -p=json -o=yaml -r -e '.target_directory')"
    rm -f "$target_dir"/wheels/bernard_ledit-*.whl
    rm -rf target/
    rm -rf *.egg-info/
    find . -type d -name "__pycache__" -exec rm -rf {} +
    rm -rf ./**/*.abi3.so
    rm -f bernard_ledit/_bernard_ledit*.so bernard_ledit/_bernard_ledit*.pyd

format:
    ruff format .
    ruff check --fix .

format-check:
    ruff format --check .
    ruff check .
    mypy .

stubs-check:
    python -m mypy.stubtest bernard_ledit

test: build
    #!/usr/bin/env bash
    set -euo pipefail
    python -m pytest -vvv -n auto
