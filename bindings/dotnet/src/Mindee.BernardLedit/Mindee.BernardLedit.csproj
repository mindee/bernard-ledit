<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The C# code is generated by uniffi-bindgen-cs into Generated/: run `just dotnet generate`.
    uniffi-bindgen-cs supports .NET 8+ and .NET Framework 4.6.1+.
  -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <RollForward>Major</RollForward>
    <PackageId>Mindee.BernardLedit</PackageId>
    <Version>0.1.0</Version>
    <Authors>Mindee</Authors>
    <Description>.NET bindings for Bernard l'Édit: PDF and image utilities.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/mindee/bernard-ledit</RepositoryUrl>
    <!-- Generated code. -->
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net472'">
    <LangVersion>10.0</LangVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="PolySharp" Version="1.15.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
