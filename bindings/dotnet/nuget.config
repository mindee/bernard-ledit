<?xml version="1.0" encoding="utf-8"?>
<!-- Restores from nuget.org only, whatever package sources the machine's own NuGet config adds. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
