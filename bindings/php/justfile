set shell := ["bash", "-c"]

ext_name := if os() == "macos" { "libbernard_ledit_php.dylib" } else if os() == "windows" { "bernard_ledit_php.dll" } else { "libbernard_ledit_php.so" }
ext_debug := "../../target/debug/" + ext_name
ext_release := "../../target/release/" + ext_name

# `php -n` skips php.ini, so the extensions the test suite needs are loaded explicitly.
php_test_exts := "-d extension=dom -d extension=xml -d extension=mbstring -d extension=tokenizer -d extension=ctype -d extension=xmlwriter"

static_feature := if os() == "macos" { "static-pdfium-libcxx" } else if os() == "windows" { "static-pdfium-msvc" } else { "static-pdfium" }

# Where core's build downloads the dynamic PDFium that debug builds load.
pdfium_release := replace(`tr -d '[:space:]' < ../../core/pdfium-release`, "/", "_")
pdfium_target := if os() == "macos" {
    if arch() == "aarch64" { "mac-arm64" } else { "mac-x64" }
} else if os() == "windows" {
    "win-x64"
} else {
    if arch() == "aarch64" { "linux-arm64" } else { "linux-x64" }
}
pdfium_dir := "../../core/.pdfium_cache/" + pdfium_release + "/" + pdfium_target
pdfium_lib := if os() == "macos" { "libpdfium.dylib" } else if os() == "windows" { "pdfium.dll" } else { "libpdfium.so" }

# Lists the recipes.
[private]
default:
    @just --list

# Builds the extension in debug mode, against the dynamic PDFium.
build:
    cargo build -p bernard-ledit-php

# Builds the extension in release mode, against the dynamic PDFium.
build-release:
    cargo build -p bernard-ledit-php --release

# PDFIUM_STATIC_LIB_PATH is the directory of libpdfium.a (pdfium.lib on Windows), as saved by
# tools/pdfium-static/download.sh, or built by tools/pdfium-static/build.sh.

# Builds the extension in release mode with PDFium linked in; needs PDFIUM_STATIC_LIB_PATH.
build-static:
    cargo build -p bernard-ledit-php --release --features {{static_feature}}

# Runs PHP with the debug build, e.g. `just php run tests/smoke.php`; see run-code for inline code.
run *ARGS: build (php-with "debug" ARGS)

# Runs PHP code with the debug build, e.g. `just php run-code 'print_r(get_loaded_extensions());'`.
run-code CODE: build (php-with "debug" "-r " + quote(CODE))

# Checks that the debug build loads.
smoke: build
    just php-with debug -m | grep -iE '^bernard[-_]ledit'

# Prints the classes and functions the debug build registers.
reflect: build
    #!/usr/bin/env bash
    set -euo pipefail
    module="$(just php-with debug -m | grep -iE '^bernard[-_]ledit' | head -n 1)"
    just php-with debug --re "$module"

# Runs the binding's PHPUnit suite against the debug build, e.g. `just php test --testdox`.
test *ARGS: composer-deps build (php-with "debug" "vendor/bin/phpunit " + ARGS)

# Runs the PHPUnit suite against the static build with no PDFium to load: proves it's linked in.
test-static: composer-deps build-static (php-with "static" "vendor/bin/phpunit")

# Regenerates the IDE and PHPStan stub file from the debug build.
stubs: build
    bash tools/stubs/generate.sh "$(realpath {{ext_debug}})" "$PWD/bernard_ledit.stubs.php"

# Regenerates the stub file and fails if it differs from the committed one.
stubs-check: stubs
    git ls-files --error-unmatch bernard_ledit.stubs.php > /dev/null
    git diff --exit-code -- bernard_ledit.stubs.php

# Runs PHPStan against the generated stubs, if Composer installed it.
phpstan: stubs
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -f vendor/bin/phpstan ]; then
        vendor/bin/phpstan analyse
    else
        echo "phpstan isn't installed (composer require --dev phpstan/phpstan); skipping." >&2
    fi

# Runs clippy on the binding crate.
lint:
    cargo clippy -p bernard-ledit-php --all-targets --all-features -- -D warnings

# Formats the binding crate.
format:
    cargo fmt -p bernard-ledit-php

# Checks the binding crate's formatting.
format-check:
    cargo fmt -p bernard-ledit-php --check

# Runs the checks CI runs: formatting, lint, build and tests.
ci: format-check lint build test

# Removes the Composer dependencies; the root `just clean` removes the shared cargo target.
clean:
    rm -rf vendor/

# Runs PHP without php.ini, with the test suite's extensions and one build of this extension:
# `debug` loads the dynamic PDFium, `static` has none to load. ARGS is pasted into the command line
# as shell code, so callers quote what needs quoting.
[private]
php-with MODE *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{MODE}}" in
        debug)
            PDFIUM_PATH="$(just pdfium-path)"
            export PDFIUM_PATH
            ext="{{ext_debug}}"
            ;;
        static)
            unset PDFIUM_PATH
            ext="{{ext_release}}"
            ;;
        *)
            echo "unknown mode '{{MODE}}' (expected debug or static)" >&2
            exit 1
            ;;
    esac
    ext_dir="$(php -r 'echo ini_get("extension_dir");')"
    php -n -d extension_dir="$ext_dir" {{php_test_exts}} -d extension="$ext" {{ARGS}}

# Prints the path of the dynamic PDFium, downloading it through core's build if it's missing.
[private]
pdfium-path:
    #!/usr/bin/env bash
    set -euo pipefail
    find_pdfium() {
        find "{{pdfium_dir}}" -name "{{pdfium_lib}}" 2>/dev/null | head -n 1 || true
    }
    lib="$(find_pdfium)"
    if [ -z "$lib" ]; then
        just -f ../../justfile core build >&2
        lib="$(find_pdfium)"
    fi
    [ -n "$lib" ] || { echo "{{pdfium_lib}} not found in {{pdfium_dir}}" >&2; exit 1; }
    realpath "$lib"

# Installs the test suite's Composer dependencies on first use.
[private]
composer-deps:
    [ -d vendor ] || composer install
