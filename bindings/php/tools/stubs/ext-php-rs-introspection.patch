+/// Splits an item like "`\ValueError` if ..." into the class and the condition.
+fn split_throws(item: &str) -> StdOption<(&str, &str)> {
+    let rest = item.strip_prefix('`')?;
+    let (class, condition) = rest.split_once('`')?;
+    let valid = class.starts_with('\\')
+        && class[1..]
+            .split('\\')
+            .all(|part| !part.is_empty() && part.chars().all(|c| c.is_alphanumeric() || c == '_'));
+    valid.then(|| (class, condition.trim()))
+}
