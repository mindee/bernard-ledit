+/// Splits "`type` rest" into the type and the rest.
+fn split_backticked(text: &str) -> StdOption<(&str, &str)> {
+    let (ty, rest) = text.strip_prefix('`')?.split_once('`')?;
+    Some((ty, rest.trim()))
+}
+
+/// Splits an item like "`\ValueError` if ..." into the class and the condition.
+fn split_throws(item: &str) -> StdOption<(&str, &str)> {
+    let (class, condition) = split_backticked(item)?;
+    let valid = class.starts_with('\\')
+        && class[1..]
+            .split('\\')
+            .all(|part| !part.is_empty() && part.chars().all(|c| c.is_alphanumeric() || c == '_'));
+    valid.then_some((class, condition))
+}
