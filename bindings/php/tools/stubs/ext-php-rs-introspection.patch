 /// Extract the PHP type from a type override string.
 /// Handles formats like "?string &$name" -> "?string"
 fn extract_php_type(type_str: &str) -> String {
     // The type override might contain reference notation like "&$name"
-    // We want just the type part
-    type_str
-        .split_whitespace()
-        .next()
-        .unwrap_or("mixed")
-        .to_string()
+    // We want just the type part, which ends at the first space outside brackets: `int<1, 100>`.
+    let type_str = type_str.trim_start();
+    let mut depth = 0_i32;
+    let end = type_str
+        .char_indices()
+        .find(|&(_, c)| {
+            match c {
+                '<' | '{' | '(' => depth += 1,
+                '>' | '}' | ')' => depth -= 1,
+                _ => {}
+            }
+            c.is_whitespace() && depth == 0
+        })
+        .map_or(type_str.len(), |(i, _)| i);
+    match &type_str[..end] {
+        "" => "mixed".to_string(),
+        ty => ty.to_string(),
+    }
 }

