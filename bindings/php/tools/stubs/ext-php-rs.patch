+fn positioned_param_to_stub(
+    param: &Parameter,
+    following: &[Parameter],
+    type_overrides: &HashMap<String, String>,
+) -> Result<String, FmtError> {
+    let mut rendered = param_to_stub(param, type_overrides)?;
+    let precedes_required = following.iter().any(|p| {
+        !p.nullable && !p.variadic && matches!(p.default, Option::None)
+    });
+    if precedes_required {
+        if let Some(default_start) = rendered.find(" = ") {
+            rendered.truncate(default_start);
+        }
+    }
+    Ok(rendered)
+}
