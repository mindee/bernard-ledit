set shell := ["bash", "-c"]

uniffi := "just -f ../uniffi/justfile"
generated := "target/generated-sources/uniffi"

# Lists the recipes.
[private]
default:
    @just --list

# Generates UniFFI's Kotlin bindings, which Java calls; `BernardLedit` holds the free functions.
generate:
    rm -rf {{generated}}
    {{uniffi}} generate kotlin "$PWD/{{generated}}"
    perl -pi -e 's/^(\@file:Suppress\("NAME_SHADOWING"\))$/$1\n\@file:JvmName("BernardLedit")/' \
        {{generated}}/com/mindee/bernardledit/bernard_ledit.kt

# Builds the jar.
build: generate
    mvn --no-transfer-progress package -DskipTests

# Runs the smoke tests against the debug library and the dynamic PDFium.
test: generate
    PDFIUM_PATH="$({{uniffi}} pdfium-path)" mvn --no-transfer-progress test \
        -DargLine="-Djna.library.path=$({{uniffi}} library-dir)"

# Formats the Java tests.
format:
    mvn --no-transfer-progress spotless:apply

# Checks the Java tests' formatting.
format-check:
    mvn --no-transfer-progress spotless:check

# Lints the Java tests.
lint:
    mvn --no-transfer-progress spotless:check pmd:check

# Runs the checks CI runs.
ci: generate
    PDFIUM_PATH="$({{uniffi}} pdfium-path)" mvn --no-transfer-progress spotless:check pmd:check test \
        -DargLine="-Djna.library.path=$({{uniffi}} library-dir)"

# Removes build artifacts.
clean:
    mvn --no-transfer-progress clean
